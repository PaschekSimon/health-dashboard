{
  "name": "health-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + TypeScript port of the health dashboard (frontend/), served at /next/ until it replaces it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:types": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
